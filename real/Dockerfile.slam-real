ARG ROS_BASE
FROM ${ROS_BASE}
LABEL codex.project="checkpoint23-docker-for-robotics" \
      codex.owner="cp23-real-fastbot" \
      org.opencontainers.image.revision="d58b5e103586314bca40626558acc82b4e40e299"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG ROS_APT_MIRROR=https://mirrors.ustc.edu.cn/ros2/ubuntu
RUN sed -i "s|http://packages.ros.org/ros2/ubuntu|${ROS_APT_MIRROR}|g;s|https://packages.ros.org/ros2/ubuntu|${ROS_APT_MIRROR}|g" /etc/apt/sources.list.d/ros2* && \
    sed -i -e '/^deb-src /d' -e 's/^Types: deb deb-src$/Types: deb/' \
    -e 's/^Types: deb-src deb$/Types: deb/' /etc/apt/sources.list.d/ros2* && \
    apt-get update -o APT::Update::Error-Mode=any && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions ros-humble-cartographer-ros \
    ros-humble-rmw-cyclonedds-cpp && rm -rf /var/lib/apt/lists/*
COPY real/src/fastbot_slam/ /ros2_ws/src/fastbot_slam/
WORKDIR /ros2_ws
RUN source /opt/ros/humble/setup.bash && \
    colcon build --parallel-workers 1 --cmake-args -DBUILD_TESTING=OFF
COPY real/entrypoint.sh /usr/local/bin/fastbot_entrypoint.sh
RUN chmod +x /usr/local/bin/fastbot_entrypoint.sh
ENTRYPOINT ["/usr/local/bin/fastbot_entrypoint.sh"]
CMD ["ros2", "launch", "fastbot_slam", "cartographer.launch.py"]
