Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/TF
      Name: FastBot TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: FastBot LaserScan
      Enabled: true
      Topic:
        Value: /fastbot/scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Size (Pixels): 4
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Image
      Name: FastBot Camera
      Enabled: true
      Image Topic: /fastbot_camera/image_raw
      Topic:
        Value: /fastbot_camera/image_raw
        Depth: 2
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Transport Hint: raw
      Normalize Range: true
      Value: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: fastbot_laser_link
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 80
      X: 0
      Y: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1100
  Height: 760
  X: 0
  Y: 0
