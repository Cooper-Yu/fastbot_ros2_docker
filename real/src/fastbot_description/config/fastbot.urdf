<?xml version="1.0"?>
<robot name="fastbot">
  <!-- Simplified visualization model. Sensor mounting transforms are estimates. -->
  <link name="fastbot_base_link">
    <visual><origin xyz="0 0 0.025"/><geometry><box size="0.16 0.14 0.05"/></geometry></visual>
  </link>
  <link name="fastbot_left_wheel"><visual><geometry><cylinder radius="0.032" length="0.025"/></geometry><origin rpy="1.57079632679 0 0"/></visual></link>
  <link name="fastbot_right_wheel"><visual><geometry><cylinder radius="0.032" length="0.025"/></geometry><origin rpy="1.57079632679 0 0"/></visual></link>
  <joint name="fastbot_left_wheel_joint" type="continuous"><parent link="fastbot_base_link"/><child link="fastbot_left_wheel"/><origin xyz="0 0.06 0"/><axis xyz="0 1 0"/></joint>
  <joint name="fastbot_right_wheel_joint" type="continuous"><parent link="fastbot_base_link"/><child link="fastbot_right_wheel"/><origin xyz="0 -0.06 0"/><axis xyz="0 1 0"/></joint>
  <link name="fastbot_laser_link"/>
  <joint name="fastbot_laser_mount" type="fixed"><parent link="fastbot_base_link"/><child link="fastbot_laser_link"/><origin xyz="0 0 0.15"/></joint>
  <link name="fastbot_camera_link"/>
  <joint name="fastbot_camera_mount" type="fixed"><parent link="fastbot_base_link"/><child link="fastbot_camera_link"/><origin xyz="0.08 0 0.08"/></joint>
  <link name="fastbot_camera_optical_frame"/>
  <joint name="fastbot_camera_optical_joint" type="fixed"><parent link="fastbot_camera_link"/><child link="fastbot_camera_optical_frame"/><origin rpy="-1.57079632679 0 -1.57079632679"/></joint>
</robot>
