Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Live map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/LaserScan
      Name: Real LiDAR
      Enabled: true
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /fastbot/scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 80
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 850
